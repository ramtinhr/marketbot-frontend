# Server-only API origin. Never expose backend credentials in NEXT_PUBLIC variables.
MARKETBOT_API_URL=http://127.0.0.1:8080
# Explicit preview mode. Keep false in production.
MARKETBOT_DEMO_MODE=false

# Set to the public HTTPS origin behind a reverse proxy, e.g. https://panel.example.com
# MARKETBOT_APP_ORIGIN=https://panel.example.com
# Enable ONLY behind an ingress that overwrites X-Real-IP and blocks direct access.
MARKETBOT_TRUST_INGRESS=false
